# Paycor Developer Portal application credentials
PAYCOR_CLIENT_ID=
PAYCOR_CLIENT_SECRET=
PAYCOR_REDIRECT_URI=http://localhost:3000/oauth/callback

# Ocp-Apim-Subscription-Key issued alongside your Paycor app registration
PAYCOR_SUBSCRIPTION_KEY=

# Paycor scopes your app was approved for (space separated)
PAYCOR_SCOPES=api.paycor.com/core

# Legal entity (client) the stored token is authorized against.
# Paycor resources are scoped per legal entity; find this via GET /v1/legalentities after auth.
PAYCOR_LEGAL_ENTITY_ID=

# Switch to production values once your app is approved for go-live.
# Confirm exact hosts in the Paycor Developer Portal docs for your app before deploying.
PAYCOR_AUTH_BASE_URL=https://identity.sandbox.paycor.com
PAYCOR_API_BASE_URL=https://apis.sandbox.paycor.com

PORT=3000

# Shared secret Power BI must send as "Authorization: Bearer <key>"
POWERBI_API_KEY=
